# Obrigatorio em producao
FLASK_SECRET_KEY=troque-por-uma-chave-forte
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Banco de dados gerenciado (Supabase/Neon/Railway)
# Exemplo: postgresql://usuario:senha@host:5432/dbname?sslmode=require
DATABASE_URL=

# Storage de fotos
# Opcoes: local | cloudinary
STORAGE_MODE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Reconhecimento facial (no Vercel, deixe 0 para reduzir falhas de deploy)
ENABLE_FACE_RECOGNITION=0

# So para execucao local
FLASK_DEBUG=0
PORT=5000
